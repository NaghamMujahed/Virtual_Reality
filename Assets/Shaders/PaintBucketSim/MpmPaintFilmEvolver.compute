#pragma kernel KEvolveFilm

struct MpmPaintFilmCell
{
    uint thickness;
    uint wetness;
    uint colorR;
    uint colorG;
    uint colorB;
    uint deposited;
    uint absorbed;
    uint impactCount;
    int flowU;
    int flowV;
    uint flags;
    uint reserved;
};

StructuredBuffer<MpmPaintFilmCell> _SourceFilmCells;
RWStructuredBuffer<MpmPaintFilmCell> _TargetFilmCells;

int _GridWidth;
int _GridHeight;
int _ThicknessUnitsPerMeter;
int _WetnessUnits;
int _ColorWeightScale;
float _DeltaTime;
int _EnableDiffusion;
int _EnableDrips;

float _AbsorptionRate;
float _SpreadFactor;
float _DripFactor;
float _DryingRate;
float _WetnessRetention;
float _Roughness;
float _PaintViscosity;
float _YieldStress;
float _ViscosityDamping;
float _MomentumFlowFactor;
float _HeightGradientFlowFactor;
float _RivuletFactor;
float _EdgeDrainFactor;
float _EdgeDripThreshold;
float _FilmFlowStartThicknessMeters;
float _PoolHoldFactor;
float _ThinFilmMobilityBelowThreshold;
float _GravityBiasInFilmFlow;
float _FlowStopThicknessFactor;

float3 _CanvasTangent;
float3 _CanvasBitangent;
float3 _CanvasNormal;
float3 _GravityDirection;
int _FlipU;
int _FlipV;
int _SwapUV;
int _Rotate90;
int _InvertTextureY;

int IndexOf(int x, int y)
{
    x = clamp(x, 0, _GridWidth - 1);
    y = clamp(y, 0, _GridHeight - 1);
    return y * _GridWidth + x;
}

float ThicknessUnits(MpmPaintFilmCell cell)
{
    return (float)cell.thickness;
}

float Wetness01(MpmPaintFilmCell cell)
{
    return saturate((float)cell.wetness / max((float)_WetnessUnits, 1.0));
}

float3 CellColor(MpmPaintFilmCell cell)
{
    if (cell.reserved == 0u)
    {
        if (cell.deposited == 0u || (cell.colorR | cell.colorG | cell.colorB) == 0u)
            return float3(0.0, 0.0, 0.0);

        float oldDenom =
            max((float)cell.deposited * max((float)_ColorWeightScale, 1.0), 1.0);
        return saturate(float3(cell.colorR, cell.colorG, cell.colorB) / oldDenom);
    }

    float denom =
        max((float)cell.reserved * max((float)_ColorWeightScale, 1.0), 1.0);
    return saturate(float3(cell.colorR, cell.colorG, cell.colorB) / denom);
}

float2 CellFlow(MpmPaintFilmCell cell)
{
    return float2((float)cell.flowU, (float)cell.flowV) / 600.0;
}

float2 ApplyUvFlowFlip(float2 flow)
{
    if (_SwapUV != 0)
        flow = flow.yx;

    if (_Rotate90 != 0)
        flow = float2(flow.y, -flow.x);

    if (_FlipU != 0)
        flow.x = -flow.x;

    if (_FlipV != 0)
        flow.y = -flow.y;

    if (_InvertTextureY != 0)
        flow.y = -flow.y;

    return flow;
}

float Hash21(float2 p)
{
    p = frac(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return frac(p.x * p.y);
}

uint SafePackColorWeight(float units, MpmPaintFilmCell source)
{
    if (source.reserved > 0u)
        return min(source.reserved, 65535u);

    if (source.deposited > 0u)
        return min(source.deposited, 4096u);

    if (source.thickness > 0u)
        return min(source.thickness, 4096u);

    return (uint)round(clamp(units, 1.0, 4096.0));
}

MpmPaintFilmCell PackCell(
    float thickness,
    float wetness,
    float3 color,
    MpmPaintFilmCell source,
    float absorbedAdd,
    float2 flowAdd,
    float flowRetention)
{
    MpmPaintFilmCell cell;
    thickness = max(thickness, 0.0);
    wetness = saturate(wetness);
    color = saturate(color);

    uint thicknessU = (uint)round(min(thickness, 4290000000.0));
    uint colorScale = (uint)max(_ColorWeightScale, 1);
    uint colorWeightU = thicknessU > 0u ? SafePackColorWeight(thickness, source) : 0u;

    cell.thickness = thicknessU;
    cell.wetness = (uint)round(wetness * (float)_WetnessUnits);
    cell.colorR = (uint)round((float)colorWeightU * color.r * (float)colorScale);
    cell.colorG = (uint)round((float)colorWeightU * color.g * (float)colorScale);
    cell.colorB = (uint)round((float)colorWeightU * color.b * (float)colorScale);
    cell.deposited = thicknessU;
    cell.absorbed = source.absorbed + (uint)round(max(absorbedAdd, 0.0));
    cell.impactCount = source.impactCount;
    float2 flow = float2((float)source.flowU, (float)source.flowV) * saturate(flowRetention) + flowAdd;
    cell.flowU = (int)round(clamp(flow.x, -8000.0, 8000.0));
    cell.flowV = (int)round(clamp(flow.y, -8000.0, 8000.0));
    cell.flags = thicknessU > 0u ? 1u : 0u;
    // reserved = colorWeight for stable pigment averaging.
    cell.reserved = colorWeightU;
    return cell;
}

[numthreads(8, 8, 1)]
void KEvolveFilm(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _GridWidth || (int)id.y >= _GridHeight)
        return;

    int x = (int)id.x;
    int y = (int)id.y;
    int idx = y * _GridWidth + x;

    MpmPaintFilmCell self = _SourceFilmCells[idx];
    MpmPaintFilmCell left = _SourceFilmCells[IndexOf(x - 1, y)];
    MpmPaintFilmCell right = _SourceFilmCells[IndexOf(x + 1, y)];
    MpmPaintFilmCell down = _SourceFilmCells[IndexOf(x, y - 1)];
    MpmPaintFilmCell up = _SourceFilmCells[IndexOf(x, y + 1)];

    float thickness = ThicknessUnits(self);
    float wetness = Wetness01(self);
    float3 color = CellColor(self);
    float2 flowAdd = float2(0.0, 0.0);

    float viscosity01 = saturate(log2(1.0 + max(_PaintViscosity, 0.0)) / 4.0);
    float yield01 = saturate(max(_YieldStress, 0.0) / 0.75);
    float mobility = saturate(1.0 - viscosity01 * _ViscosityDamping - yield01 * 0.35);
    float flowStartUnits =
        max(_FilmFlowStartThicknessMeters, 0.0) *
        max((float)_ThicknessUnitsPerMeter, 1.0) *
        (1.0 + viscosity01 * 0.85 + yield01 * 0.55);
    flowStartUnits = max(flowStartUnits, 1.0);
    float flowStopUnits = flowStartUnits * saturate(_FlowStopThicknessFactor);
    float accumulation01 = saturate((thickness - flowStartUnits) / flowStartUnits);
    float thinMobility = saturate(_ThinFilmMobilityBelowThreshold);
    float release01 = smoothstep(flowStopUnits, flowStartUnits * 1.15, thickness);
    float gatedMobility = lerp(thinMobility * 0.35, 1.0, accumulation01) * release01;
    float heldThickness = flowStartUnits * saturate(_PoolHoldFactor);
    float flowRetention =
        lerp(0.52, 0.965, saturate(gatedMobility * wetness)) *
        (thickness > flowStopUnits ? 1.0 : 0.45);

    float3 gravity = normalize(_GravityDirection);
    float2 gravityUv = float2(
        dot(gravity, normalize(_CanvasTangent)),
        dot(gravity, normalize(_CanvasBitangent))
    );
    gravityUv = ApplyUvFlowFlip(gravityUv);
    float slope = saturate(length(gravityUv));
    float2 downhillDir = slope > 1e-4 ? gravityUv / max(slope, 1e-4) : float2(0.0, -1.0);

    float retention = max(_WetnessRetention, 0.05);
    float dryFactor = exp(-max(_DryingRate, 0.0) * _DeltaTime / retention);
    wetness *= dryFactor;
    wetness -= saturate(_AbsorptionRate) * _DeltaTime * 0.08;
    wetness = saturate(wetness);

    float absorbed = thickness * saturate(_AbsorptionRate) * wetness * _DeltaTime * 0.018;
    thickness = max(0.0, thickness - absorbed);

    if (_EnableDiffusion != 0)
    {
        float leftThickness = ThicknessUnits(left);
        float rightThickness = ThicknessUnits(right);
        float downThickness = ThicknessUnits(down);
        float upThickness = ThicknessUnits(up);
        float neighborMass =
            leftThickness +
            rightThickness +
            downThickness +
            upThickness;
        float neighborAverage = neighborMass * 0.25;

        float diffusion =
            saturate(_SpreadFactor) *
            mobility *
            max(gatedMobility, thinMobility * 0.08) *
            max(wetness, neighborMass > 0.0 ? 0.35 : 0.0) *
            (1.0 - saturate(_Roughness) * 0.45) *
            _DeltaTime *
            0.34;

        float targetThickness = lerp(thickness, neighborAverage, saturate(diffusion));
        if (targetThickness < thickness)
            targetThickness = max(targetThickness, min(thickness, heldThickness));
        float incoming = max(0.0, targetThickness - thickness);
        if (incoming > 0.0 && neighborMass > 0.0)
        {
            float3 neighborColor =
                (CellColor(left) * leftThickness +
                 CellColor(right) * rightThickness +
                 CellColor(down) * downThickness +
                 CellColor(up) * upThickness) /
                max(neighborMass, 1.0);
            float neighborWetness =
                (Wetness01(left) * leftThickness +
                 Wetness01(right) * rightThickness +
                 Wetness01(down) * downThickness +
                 Wetness01(up) * upThickness) /
                max(neighborMass, 1.0);

            color = (color * thickness + neighborColor * incoming) /
                max(targetThickness, 1.0);
            wetness = max(wetness, neighborWetness);
        }

        thickness = targetThickness;
    }

    if (_HeightGradientFlowFactor > 0.0)
    {
        float leftThickness = ThicknessUnits(left);
        float rightThickness = ThicknessUnits(right);
        float downThickness = ThicknessUnits(down);
        float upThickness = ThicknessUnits(up);

        float pressureStep =
            max(_HeightGradientFlowFactor, 0.0) *
            mobility *
            gatedMobility *
            max(wetness, 0.18) *
            saturate(_SpreadFactor) *
            (1.0 - saturate(_Roughness) * 0.52) *
            _DeltaTime *
            0.42;

        float selfOut =
            max(thickness - leftThickness, 0.0) +
            max(thickness - rightThickness, 0.0) +
            max(thickness - downThickness, 0.0) +
            max(thickness - upThickness, 0.0);
        selfOut *= pressureStep * 0.25;
        selfOut = min(selfOut, max(thickness - heldThickness, 0.0));

        float inLeft = max(leftThickness - thickness, 0.0) * pressureStep * 0.25;
        float inRight = max(rightThickness - thickness, 0.0) * pressureStep * 0.25;
        float inDown = max(downThickness - thickness, 0.0) * pressureStep * 0.25;
        float inUp = max(upThickness - thickness, 0.0) * pressureStep * 0.25;
        float incoming = inLeft + inRight + inDown + inUp;

        float remaining = max(0.0, thickness - selfOut);
        float newThickness = remaining + incoming;

        if (incoming > 0.0 && newThickness > 0.0)
        {
            float3 incomingColor =
                CellColor(left) * inLeft +
                CellColor(right) * inRight +
                CellColor(down) * inDown +
                CellColor(up) * inUp;
            incomingColor /= max(incoming, 1.0);

            float incomingWetness =
                Wetness01(left) * inLeft +
                Wetness01(right) * inRight +
                Wetness01(down) * inDown +
                Wetness01(up) * inUp;
            incomingWetness /= max(incoming, 1.0);

            color = (color * remaining + incomingColor * incoming) / max(newThickness, 1.0);
            wetness = max(wetness, incomingWetness);
        }

        float2 heightPush = float2(leftThickness - rightThickness, downThickness - upThickness);
        flowAdd += clamp(heightPush * pressureStep * 0.24, -1500.0, 1500.0);
        flowAdd += clamp(
            downhillDir *
            slope *
            max(_GravityBiasInFilmFlow, 0.0) *
            pressureStep *
            max(thickness - heldThickness, 0.0) *
            0.018,
            -1500.0,
            1500.0
        );
        thickness = newThickness;
    }

    if (_MomentumFlowFactor > 0.0)
    {
        float2 selfFlow = CellFlow(self);
        float selfFlowSpeed = saturate(length(selfFlow));
        float flowStep =
            max(_MomentumFlowFactor, 0.0) *
            mobility *
            gatedMobility *
            _DeltaTime *
            1.05;

        float outflow =
            thickness *
            wetness *
            selfFlowSpeed *
            flowStep;
        outflow = min(outflow, max(thickness - heldThickness, 0.0));

        float incoming = 0.0;
        float3 incomingColorSum = float3(0.0, 0.0, 0.0);
        float incomingWetnessSum = 0.0;

        float2 leftFlow = CellFlow(left);
        float leftIn = saturate(max(leftFlow.x, 0.0)) *
            ThicknessUnits(left) *
            Wetness01(left) *
            flowStep;
        incoming += leftIn;
        incomingColorSum += CellColor(left) * leftIn;
        incomingWetnessSum += Wetness01(left) * leftIn;

        float2 rightFlow = CellFlow(right);
        float rightIn = saturate(max(-rightFlow.x, 0.0)) *
            ThicknessUnits(right) *
            Wetness01(right) *
            flowStep;
        incoming += rightIn;
        incomingColorSum += CellColor(right) * rightIn;
        incomingWetnessSum += Wetness01(right) * rightIn;

        float2 downFlow = CellFlow(down);
        float downIn = saturate(max(downFlow.y, 0.0)) *
            ThicknessUnits(down) *
            Wetness01(down) *
            flowStep;
        incoming += downIn;
        incomingColorSum += CellColor(down) * downIn;
        incomingWetnessSum += Wetness01(down) * downIn;

        float2 upFlow = CellFlow(up);
        float upIn = saturate(max(-upFlow.y, 0.0)) *
            ThicknessUnits(up) *
            Wetness01(up) *
            flowStep;
        incoming += upIn;
        incomingColorSum += CellColor(up) * upIn;
        incomingWetnessSum += Wetness01(up) * upIn;

        float remaining = max(0.0, thickness - outflow);
        float newThickness = remaining + incoming;
        if (incoming > 0.0 && newThickness > 0.0)
        {
            float3 incomingColor = incomingColorSum / max(incoming, 1.0);
            float incomingWetness = incomingWetnessSum / max(incoming, 1.0);
            color = (color * remaining + incomingColor * incoming) / max(newThickness, 1.0);
            wetness = max(wetness, incomingWetness * saturate(incoming / max(newThickness, 1.0)));
        }

        thickness = newThickness;
    }

    if (_EnableDrips != 0)
    {
        if (slope > 0.02)
        {
            int2 stepDir = abs(gravityUv.x) > abs(gravityUv.y)
                ? int2(gravityUv.x >= 0.0 ? 1 : -1, 0)
                : int2(0, gravityUv.y >= 0.0 ? 1 : -1);

            MpmPaintFilmCell upstream =
                _SourceFilmCells[IndexOf(x - stepDir.x, y - stepDir.y)];

            float selfOut =
                thickness *
                wetness *
                max(_DripFactor, 0.0) *
                (1.0 + max(_GravityBiasInFilmFlow, 0.0) * 0.45) *
                mobility *
                gatedMobility *
                slope *
                _DeltaTime *
                0.28;
            selfOut = min(selfOut, max(thickness - heldThickness, 0.0));

            float upstreamThickness = ThicknessUnits(upstream);
            float upstreamWetness = Wetness01(upstream);
            float rivuletNoise = Hash21(float2(x, y) * 0.37 + gravityUv * 17.0);
            float rivuletBand = smoothstep(0.18, 0.72, rivuletNoise);
            float rivuletGain =
                1.0 +
                max(_RivuletFactor, 0.0) *
                rivuletBand *
                saturate(upstreamThickness / max((float)_ThicknessUnitsPerMeter * 0.0015, 1.0));
            float incoming =
                upstreamThickness *
                upstreamWetness *
                max(_DripFactor, 0.0) *
                (1.0 + max(_GravityBiasInFilmFlow, 0.0) * 0.45) *
                mobility *
                gatedMobility *
                slope *
                _DeltaTime *
                0.28 *
                rivuletGain;

            float remaining = max(0.0, thickness - selfOut);
            float newThickness = remaining + incoming;

            if (incoming > 0.0)
            {
                float3 upstreamColor = CellColor(upstream);
                color = (color * remaining + upstreamColor * incoming) / max(newThickness, 1.0);
                wetness = max(wetness, upstreamWetness * saturate(incoming / max(newThickness, 1.0)));
            }

            thickness = newThickness;
            flowAdd += gravityUv * (selfOut + incoming) * (0.0035 + max(_GravityBiasInFilmFlow, 0.0) * 0.0025);

            bool onDrainEdge =
                (gravityUv.x < -0.15 && x == 0) ||
                (gravityUv.x > 0.15 && x == _GridWidth - 1) ||
                (gravityUv.y < -0.15 && y == 0) ||
                (gravityUv.y > 0.15 && y == _GridHeight - 1);

            float thresholdUnits =
                max(_EdgeDripThreshold, 0.0) *
                max((float)_ThicknessUnitsPerMeter, 1.0);
            if (onDrainEdge && thickness > thresholdUnits)
            {
                float drain =
                    (thickness - thresholdUnits) *
                    wetness *
                    max(_EdgeDrainFactor, 0.0) *
                    slope *
                    mobility *
                    gatedMobility *
                    _DeltaTime *
                    0.85;
                thickness = max(0.0, thickness - drain);
                absorbed += drain * 0.18;
            }
        }
    }

    _TargetFilmCells[idx] = PackCell(thickness, wetness, color, self, absorbed, flowAdd, flowRetention);
}
