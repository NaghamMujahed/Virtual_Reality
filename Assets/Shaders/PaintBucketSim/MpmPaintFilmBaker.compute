#pragma kernel KBakeFilm

struct MpmPaintFilmCell
{
    uint thickness;
    uint wetness;
    uint colorR;
    uint colorG;
    uint colorB;
    uint deposited;
    uint absorbed;
    uint impactCount;
    int flowU;
    int flowV;
    uint flags;
    uint reserved;
};

StructuredBuffer<MpmPaintFilmCell> _FilmCells;
RWTexture2D<float4> _OutputTexture;
RWTexture2D<float4> _NormalTexture;
RWTexture2D<float4> _MaterialTexture;
RWTexture2D<float4> _HeightTexture;

int _GridWidth;
int _GridHeight;
int _ThicknessUnitsPerMeter;
int _WetnessUnits;
int _ColorWeightScale;
float _MaxVisibleThickness;
float4 _BackgroundColor;
float _WetDarkening;
float _WetGlossBoost;
float _PigmentContrast;
float _NormalFromThicknessStrength;
float _VisualHeightScale;
float _SurfaceRoughness;
float _GlossResponse;
float _FilmFlowStartThicknessMeters;
int _FlipU;
int _FlipV;
int _SwapUV;
int _Rotate90;
int _InvertTextureY;
int _DebugView;

float3 Heatmap(float t)
{
    t = saturate(t);
    float3 blue = float3(0.05, 0.20, 0.95);
    float3 cyan = float3(0.00, 0.80, 0.95);
    float3 yellow = float3(1.00, 0.86, 0.10);
    float3 red = float3(0.95, 0.05, 0.02);

    float3 a = lerp(blue, cyan, saturate(t * 3.0));
    float3 b = lerp(cyan, yellow, saturate((t - 0.33) * 3.0));
    float3 c = lerp(yellow, red, saturate((t - 0.66) * 3.0));

    return t < 0.33 ? a : (t < 0.66 ? b : c);
}

float2 InverseRemapUv(float2 uv01)
{
    if (_InvertTextureY != 0)
        uv01.y = 1.0 - uv01.y;

    if (_FlipV != 0)
        uv01.y = 1.0 - uv01.y;

    if (_FlipU != 0)
        uv01.x = 1.0 - uv01.x;

    if (_Rotate90 != 0)
        uv01 = float2(1.0 - uv01.y, uv01.x);

    if (_SwapUV != 0)
        uv01 = uv01.yx;

    return uv01;
}

int IndexOf(int x, int y)
{
    x = clamp(x, 0, _GridWidth - 1);
    y = clamp(y, 0, _GridHeight - 1);
    return y * _GridWidth + x;
}

float ThicknessMetersAt(int x, int y)
{
    MpmPaintFilmCell cell = _FilmCells[IndexOf(x, y)];
    return (float)cell.thickness / max((float)_ThicknessUnitsPerMeter, 1.0);
}

[numthreads(8, 8, 1)]
void KBakeFilm(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _GridWidth || (int)id.y >= _GridHeight)
        return;

    int index = (int)id.y * _GridWidth + (int)id.x;
    MpmPaintFilmCell cell = _FilmCells[index];

    float thicknessMeters =
        (float)cell.thickness / max((float)_ThicknessUnitsPerMeter, 1.0);
    float coverage = saturate(thicknessMeters / max(_MaxVisibleThickness, 1e-7));
    coverage = 1.0 - exp(-coverage * 2.25);

    float wetness = saturate((float)cell.wetness / max((float)_WetnessUnits, 1.0));
    float leftThickness = ThicknessMetersAt((int)id.x - 1, (int)id.y);
    float rightThickness = ThicknessMetersAt((int)id.x + 1, (int)id.y);
    float downThickness = ThicknessMetersAt((int)id.x, (int)id.y - 1);
    float upThickness = ThicknessMetersAt((int)id.x, (int)id.y + 1);
    float2 heightGradient =
        float2(rightThickness - leftThickness, upThickness - downThickness) *
        max(_NormalFromThicknessStrength, 0.0) *
        64.0;
    float3 tangentNormal = normalize(float3(-heightGradient.x, -heightGradient.y, 1.0));
    float height01 = saturate(thicknessMeters / max(_VisualHeightScale, 1e-6));
    float smoothness = saturate(lerp(0.08, 0.86, wetness) + _WetGlossBoost * wetness + _GlossResponse * 0.25);
    float roughness = saturate(lerp(_SurfaceRoughness, 0.04, wetness));

    _NormalTexture[id.xy] = float4(tangentNormal * 0.5 + 0.5, 1.0);
    _MaterialTexture[id.xy] = float4(0.0, wetness, roughness, smoothness);
    _HeightTexture[id.xy] = float4(height01, height01, height01, 1.0);

    float3 paintColor = _BackgroundColor.rgb;
    if (cell.reserved > 0u)
    {
        float colorWeight = max((float)cell.reserved, 1.0);
        float denom = colorWeight * max((float)_ColorWeightScale, 1.0);
        paintColor = float3(cell.colorR, cell.colorG, cell.colorB) / max(denom, 1.0);
        paintColor = saturate(paintColor);
    }
    else if (cell.deposited > 0u && (cell.colorR | cell.colorG | cell.colorB) != 0u)
    {
        float denom = max((float)cell.deposited * max((float)_ColorWeightScale, 1.0), 1.0);
        paintColor = saturate(float3(cell.colorR, cell.colorG, cell.colorB) / denom);
    }

    if (_DebugView == 1)
    {
        _OutputTexture[id.xy] = float4(Heatmap(saturate(thicknessMeters / max(_MaxVisibleThickness, 1e-7))), 1.0);
        return;
    }

    if (_DebugView == 2)
    {
        _OutputTexture[id.xy] = float4(Heatmap(wetness), 1.0);
        return;
    }

    if (_DebugView == 3)
    {
        float impact = saturate(log2(1.0 + (float)cell.impactCount) / 6.0);
        _OutputTexture[id.xy] = float4(Heatmap(impact), 1.0);
        return;
    }

    if (_DebugView == 4)
    {
        float2 uv = InverseRemapUv(float2(
            (float)id.x / max((float)(_GridWidth - 1), 1.0),
            (float)id.y / max((float)(_GridHeight - 1), 1.0)
        ));
        float gridLine =
            step(frac(uv.x * 16.0), 0.025) +
            step(frac(uv.y * 16.0), 0.025);
        float3 uvColor = float3(uv.x, uv.y, 0.2);
        uvColor = lerp(uvColor, float3(1.0, 1.0, 1.0), saturate(gridLine));
        _OutputTexture[id.xy] = float4(uvColor, 1.0);
        return;
    }

    if (_DebugView == 5)
    {
        float2 flow = float2((float)cell.flowU, (float)cell.flowV) / 6000.0;
        float mag = saturate(length(flow));
        float3 dirColor = float3(flow.x * 0.5 + 0.5, flow.y * 0.5 + 0.5, 0.18 + 0.82 * mag);
        _OutputTexture[id.xy] = float4(lerp(float3(0.02, 0.02, 0.025), saturate(dirColor), mag), 1.0);
        return;
    }

    if (_DebugView == 6)
    {
        float startThickness = max(_FilmFlowStartThicknessMeters, 1e-7);
        float activation = saturate((thicknessMeters - startThickness) / startThickness);
        _OutputTexture[id.xy] = float4(Heatmap(activation), 1.0);
        return;
    }

    if (_DebugView == 7)
    {
        bool missingWeight = cell.reserved == 0u && (cell.deposited > 0u || cell.thickness > 0u);
        float denom =
            max((float)cell.reserved * max((float)_ColorWeightScale, 1.0), 1.0);
        float maxChannel = max((float)cell.colorR, max((float)cell.colorG, (float)cell.colorB));
        bool overweight = cell.reserved > 0u && maxChannel > denom * 1.15;

        float3 ok = lerp(float3(0.02, 0.02, 0.025), float3(0.0, 0.85, 0.35), coverage);
        float3 warning = overweight ? float3(1.0, 0.65, 0.05) : ok;
        _OutputTexture[id.xy] = float4(missingWeight ? float3(1.0, 0.05, 0.05) : warning, 1.0);
        return;
    }

    float3 pigment = paintColor;
    pigment = lerp(pigment, saturate((pigment - 0.5) * (1.0 + _PigmentContrast) + 0.5), coverage);

    float3 color = lerp(_BackgroundColor.rgb, pigment, coverage);
    color *= lerp(1.0, 1.0 - saturate(_WetDarkening), wetness * coverage);

    float edgeLift = saturate(length(heightGradient) * 0.16);
    float gloss = wetness * coverage * saturate(_WetGlossBoost + _GlossResponse * 0.55);
    color = lerp(color, min(color + 0.20 + edgeLift * 0.10, float3(1.0, 1.0, 1.0)), gloss);
    color *= 1.0 + edgeLift * coverage * 0.10;

    _OutputTexture[id.xy] = float4(saturate(color), 1.0);
}
