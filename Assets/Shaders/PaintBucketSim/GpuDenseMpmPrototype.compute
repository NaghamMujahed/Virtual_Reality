uint FlattenMpmTileIndex(uint3 tile)
{
    return tile.x +
           tile.y * (uint)_MpmTileResolution.x +
           tile.z *
           (uint)_MpmTileResolution.x *
           (uint)_MpmTileResolution.y;
}

uint3 UnflattenMpmTileIndex(uint tileIndex)
{
    uint resolutionX = (uint)_MpmTileResolution.x;
    uint resolutionY = (uint)_MpmTileResolution.y;
    uint xy = resolutionX * resolutionY;

    uint z = tileIndex / xy;
    uint rem = tileIndex - z * xy;
    uint y = rem / resolutionX;
    uint x = rem - y * resolutionX;

    return uint3(x, y, z);
}

int FlattenGridIndex(int3 c)
{
    return c.x +
           c.y * _GridResolution.x +
           c.z * _GridResolution.x * _GridResolution.y;
}

int3 UnflattenGridIndex(uint index)
{
    uint resolutionX = (uint)_GridResolution.x;
    uint resolutionY = (uint)_GridResolution.y;
    uint xy = resolutionX * resolutionY;

    uint z = index / xy;
    uint rem = index - z * xy;
    uint y = rem / resolutionX;
    uint x = rem - y * resolutionX;

    return int3((int)x, (int)y, (int)z);
}

bool TryGetMpmTileForCell(int3 cell, out uint tileIndex)
{
    tileIndex = 0u;

    if (cell.x < 0 ||
        cell.y < 0 ||
        cell.z < 0 ||
        cell.x >= _GridResolution.x ||
        cell.y >= _GridResolution.y ||
        cell.z >= _GridResolution.z)
    {
        return false;
    }

    uint3 tile = uint3(
        (uint)cell.x >> (uint)_MpmTileSizeShift,
        (uint)cell.y >> (uint)_MpmTileSizeShift,
        (uint)cell.z >> (uint)_MpmTileSizeShift
    );

    if (tile.x >= (uint)_MpmTileResolution.x ||
        tile.y >= (uint)_MpmTileResolution.y ||
        tile.z >= (uint)_MpmTileResolution.z)
    {
        return false;
    }

    tileIndex = FlattenMpmTileIndex(tile);
    return tileIndex < (uint)_MpmTileCount;
}

bool TryGetMpmTileForCoord(uint3 tile, out uint tileIndex)
{
    tileIndex = 0u;

    if (tile.x >= (uint)_MpmTileResolution.x ||
        tile.y >= (uint)_MpmTileResolution.y ||
        tile.z >= (uint)_MpmTileResolution.z)
    {
        return false;
    }

    tileIndex = FlattenMpmTileIndex(tile);
    return tileIndex < (uint)_MpmTileCount;
}

uint MpmTileThreadLinearIndex(uint3 localId)
{
    return localId.x +
           localId.y * MPM_TILE_THREAD_DIM +
           localId.z * MPM_TILE_THREAD_DIM * MPM_TILE_THREAD_DIM;
}

uint MpmTileLocalCellIndex(int3 localCell)
{
    return (uint)localCell.x +
           (uint)localCell.y * (uint)_MpmTileSizeCells +
           (uint)localCell.z *
           (uint)_MpmTileSizeCells *
           (uint)_MpmTileSizeCells;
}

bool TryGetMpmSupportTileRange(
    int3 baseCell,
    out uint3 minTile,
    out uint3 maxTile)
{
    int3 minCell = baseCell;
    int3 maxCell = baseCell + int3(2, 2, 2);

    minCell = max(minCell, int3(0, 0, 0));
    maxCell = min(maxCell, _GridResolution - int3(1, 1, 1));

    if (minCell.x > maxCell.x ||
        minCell.y > maxCell.y ||
        minCell.z > maxCell.z)
    {
        minTile = uint3(0, 0, 0);
        maxTile = uint3(0, 0, 0);
        return false;
    }

    minTile = uint3(
        (uint)minCell.x >> (uint)_MpmTileSizeShift,
        (uint)minCell.y >> (uint)_MpmTileSizeShift,
        (uint)minCell.z >> (uint)_MpmTileSizeShift
    );

    maxTile = uint3(
        (uint)maxCell.x >> (uint)_MpmTileSizeShift,
        (uint)maxCell.y >> (uint)_MpmTileSizeShift,
        (uint)maxCell.z >> (uint)_MpmTileSizeShift
    );

    return true;
}

bool TryGetMpmOwnerTileForStencil(
    int3 baseCell,
    uint3 fallbackMinTile,
    out uint ownerTileIndex)
{
    ownerTileIndex = 0u;
    bool ownerValid = false;

    // The middle node maximizes shared-memory contributions when the
    // quadratic stencil crosses a tile edge.
    int3 centerCell = baseCell + int3(1, 1, 1);
    uint centeredTileIndex = 0u;
    if (TryGetMpmTileForCell(centerCell, centeredTileIndex))
    {
        ownerTileIndex = centeredTileIndex;
        ownerValid = true;
    }

    if (!ownerValid)
    {
        uint fallbackTileIndex = 0u;
        bool fallbackValid = TryGetMpmTileForCoord(
            fallbackMinTile,
            fallbackTileIndex
        );
        if (fallbackValid)
        {
            ownerTileIndex = fallbackTileIndex;
            ownerValid = true;
        }
    }

    return ownerValid;
}

bool TryGetMpmActiveTileCell(
    uint activeTileListIndex,
    uint3 localId,
    out int gridIndex,
    out int3 cell)
{
    gridIndex = 0;
    cell = int3(0, 0, 0);

    if (localId.x >= (uint)_MpmTileSizeCells ||
        localId.y >= (uint)_MpmTileSizeCells ||
        localId.z >= (uint)_MpmTileSizeCells)
    {
        return false;
    }

    if (activeTileListIndex >= (uint)_MpmTileCount)
        return false;

    uint tileIndex = _MpmActiveTileIndices[activeTileListIndex];
    if (tileIndex >= (uint)_MpmTileCount)
        return false;

    uint3 tile = UnflattenMpmTileIndex(tileIndex);
    uint3 gridCell =
        tile * (uint)_MpmTileSizeCells +
        uint3(localId.x, localId.y, localId.z);

    if (gridCell.x >= (uint)_GridResolution.x ||
        gridCell.y >= (uint)_GridResolution.y ||
        gridCell.z >= (uint)_GridResolution.z)
    {
        return false;
    }

    cell = int3((int)gridCell.x, (int)gridCell.y, (int)gridCell.z);
    gridIndex = FlattenGridIndex(cell);
    return true;
}

bool IsValidCell(int3 c)
{
    return c.x >= 0 && c.y >= 0 && c.z >= 0 &&
           c.x < _GridResolution.x &&
           c.y < _GridResolution.y &&
           c.z < _GridResolution.z;
}

bool IsInsideActiveProjectionBounds(int3 cell)
{
    if (_EnableActiveProjectionBounds == 0)
        return true;

    return
        cell.x >= _ActiveProjectionMin.x &&
        cell.y >= _ActiveProjectionMin.y &&
        cell.z >= _ActiveProjectionMin.z &&
        cell.x < _ActiveProjectionMin.x + _ActiveProjectionSize.x &&
        cell.y < _ActiveProjectionMin.y + _ActiveProjectionSize.y &&
        cell.z < _ActiveProjectionMin.z + _ActiveProjectionSize.z;
}

bool TryGetProjectionDispatchCell(
    uint3 dispatchId,
    out int gridIndex,
    out int3 cell)
{
    gridIndex = 0;
    cell = int3(0, 0, 0);
    bool valid = false;

    if (_EnableMpmTileProjectionDispatch != 0)
    {
        // One indirect x-group represents one 8^3 active MPM tile.
        // Bit operations avoid the integer-division path warned about by D3D11.
        uint activeTileListIndex = dispatchId.x >> 3u;
        if (activeTileListIndex < (uint)_MpmTileCount)
        {
            uint tileIndex =
                _MpmActiveTileIndicesRead[activeTileListIndex];
            if (tileIndex < (uint)_MpmTileCount)
            {
                uint3 tile = UnflattenMpmTileIndex(tileIndex);
                uint3 gridCell =
                    tile * 8u +
                    uint3(
                        dispatchId.x & 7u,
                        dispatchId.y,
                        dispatchId.z
                    );

                if (gridCell.x < (uint)_GridResolution.x &&
                    gridCell.y < (uint)_GridResolution.y &&
                    gridCell.z < (uint)_GridResolution.z)
                {
                    int3 candidateCell = int3(
                        (int)gridCell.x,
                        (int)gridCell.y,
                        (int)gridCell.z
                    );
                    cell = candidateCell;
                    gridIndex = FlattenGridIndex(candidateCell);
                    valid = true;
                }
            }
        }
    }
    else if (_EnableActiveProjectionBounds == 0)
    {
        if (dispatchId.x < (uint)_GridResolution.x &&
            dispatchId.y < (uint)_GridResolution.y &&
            dispatchId.z < (uint)_GridResolution.z)
        {
            int3 candidateCell = int3(
                (int)dispatchId.x,
                (int)dispatchId.y,
                (int)dispatchId.z
            );
            cell = candidateCell;
            gridIndex = FlattenGridIndex(candidateCell);
            valid = true;
        }
    }
    else if (
        dispatchId.x < (uint)_ActiveProjectionSize.x &&
        dispatchId.y < (uint)_ActiveProjectionSize.y &&
        dispatchId.z < (uint)_ActiveProjectionSize.z)
    {
        int3 candidateCell =
            _ActiveProjectionMin +
            int3(
            (int)dispatchId.x,
            (int)dispatchId.y,
            (int)dispatchId.z
        );

        if (IsValidCell(candidateCell))
        {
            cell = candidateCell;
            gridIndex = FlattenGridIndex(candidateCell);
            valid = true;
        }
    }

    return valid;
}

bool IsProjectionReadableCell(int3 cell)
{
    bool readable = false;

    if (IsValidCell(cell))
    {
        if (_EnableMpmTileProjectionDispatch != 0)
        {
            uint tileIndex = 0u;
            if (TryGetMpmTileForCell(cell, tileIndex))
                readable = _MpmTileFlagsRead[tileIndex] != 0u;
        }
        else
        {
            readable = IsInsideActiveProjectionBounds(cell);
        }
    }

    return readable;
}

int GetProjectionCellTypeSafe(int3 cell)
{
    if (!IsValidCell(cell))
        return PROJECTION_SOLID;

    if (!IsProjectionReadableCell(cell))
        return PROJECTION_AIR;

    int index = FlattenGridIndex(cell);
    return _ProjectionCellTypeRead[index];
}

float3 GetProjectionVelocitySafe(int3 cell, float3 centerVelocity)
{
    if (!IsProjectionReadableCell(cell))
        return centerVelocity;

    int index = FlattenGridIndex(cell);
    int cellType = _ProjectionCellTypeRead[index];

    if (_ProjectionSolidNoFlux != 0 && cellType == PROJECTION_SOLID)
    {
        // No normal flow approximation:
        // use center velocity so this side contributes zero difference.
        return centerVelocity;
    }

    float4 vm = _GridVelocityMassRead[index];

    // Air cells often have zero mass/velocity. For free surface V1,
    // this is acceptable and helps reveal expansion/compression near surface.
    return vm.xyz;
}

float ClampDivergence(float d)
{
    float limit = max(_MaxAbsProjectionDivergence, 0.01);
    return clamp(d, -limit, limit);
}

bool IsMpmActiveState(int state)
{
    return
        state == 1 ||
        state == 2 ||
        state == 3 ||
        (_EnableJetMpmCollar != 0 && state == 4);
}

bool IsBucketCollisionState(int state)
{
    return state == 1 || state == 2 || state == 3;
}

bool IsBucketLocalState(int state)
{
    return
        state == 1 ||
        state == 2 ||
        state == 3 ||
        (_EnableJetMpmCollar != 0 && state == 4);
}

void AccumulateSorNeighborPressure(
    int3 neighborCell,
    float centerPressure,
    inout float pressureSum,
    inout float diagonalCount)
{
    // Out of grid behaves like solid wall.
    if (!IsValidCell(neighborCell))
    {
        if (_ProjectionSolidPressureNeumann != 0)
        {
            pressureSum += centerPressure;
            diagonalCount += 1.0;
        }

        return;
    }

    if (!IsProjectionReadableCell(neighborCell))
    {
        if (_ProjectionAirPressureZero != 0)
        {
            pressureSum += 0.0;
            diagonalCount += 1.0;
        }

        return;
    }

    int neighborIndex = FlattenGridIndex(neighborCell);
    int neighborType = _ProjectionCellTypeRead[neighborIndex];

    if (neighborType == PROJECTION_FLUID)
    {
        pressureSum += _ProjectionPressure[neighborIndex];
        diagonalCount += 1.0;
        return;
    }

    if (neighborType == PROJECTION_AIR)
    {
        // Free surface: pressure = 0.
        if (_ProjectionAirPressureZero != 0)
        {
            pressureSum += 0.0;
            diagonalCount += 1.0;
        }

        return;
    }

    if (neighborType == PROJECTION_SOLID)
    {
        // Solid wall: zero pressure gradient approximation.
        if (_ProjectionSolidPressureNeumann != 0)
        {
            pressureSum += centerPressure;
            diagonalCount += 1.0;
        }

        return;
    }
}

float ClampProjectionPressure(float p)
{
    float limit = max(_MaxProjectionPressure, 1.0);
    return clamp(p, -limit, limit);
}

bool IsProjectionInteriorFluidCell(int3 cell)
{
    return
        GetProjectionCellTypeSafe(cell + int3(-1, 0, 0)) ==
            PROJECTION_FLUID &&
        GetProjectionCellTypeSafe(cell + int3(1, 0, 0)) ==
            PROJECTION_FLUID &&
        GetProjectionCellTypeSafe(cell + int3(0, -1, 0)) ==
            PROJECTION_FLUID &&
        GetProjectionCellTypeSafe(cell + int3(0, 1, 0)) ==
            PROJECTION_FLUID &&
        GetProjectionCellTypeSafe(cell + int3(0, 0, -1)) ==
            PROJECTION_FLUID &&
        GetProjectionCellTypeSafe(cell + int3(0, 0, 1)) ==
            PROJECTION_FLUID;
}

float GetProjectionDensityTargetDivergence(
    int index,
    int3 cell)
{
    if (_EnableProjectionDensityDriftCorrection == 0)
        return 0.0;

    float densityRatio =
        max(_ProjectionCellDataRead[index].y, 0.0);
    float upperRatio =
        max(_ProjectionDensityDriftMinRatio, 1.0);
    float lowerRatio = max(2.0 - upperRatio, 0.0);
    float densityError = 0.0;

    if (densityRatio > upperRatio)
    {
        densityError = densityRatio - upperRatio;
    }
    else if (
        densityRatio < lowerRatio &&
        IsProjectionInteriorFluidCell(cell))
    {
        // Negative target divergence contracts under-dense interior cells.
        // Free-surface cells are deliberately excluded.
        densityError = densityRatio - lowerRatio;
    }

    float targetDivergence =
        max(_ProjectionDensityDriftStrength, 0.0) *
        densityError /
        max(_Dt, 1e-6);

    float maxTarget =
        max(_ProjectionDensityDriftMaxDivergence, 0.0);
    return clamp(
        targetDivergence,
        -maxTarget,
        maxTarget
    );
}

float3 ClampVectorLength(float3 v, float maxLen)
{
    float len = length(v);

    if (len > maxLen && len > 1e-6)
        return v / len * maxLen;

    return v;
}

float GetPressureForGradient(int3 neighborCell, float centerPressure)
{
    if (!IsValidCell(neighborCell))
    {
        // Outside grid behaves like solid Neumann boundary.
        if (_ProjectionSolidPressureNeumann != 0)
            return centerPressure;

        return 0.0;
    }

    if (!IsProjectionReadableCell(neighborCell))
    {
        if (_ProjectionAirPressureZero != 0)
            return 0.0;

        return centerPressure;
    }

    int neighborIndex = FlattenGridIndex(neighborCell);
    int neighborType = _ProjectionCellTypeRead[neighborIndex];

    if (neighborType == PROJECTION_FLUID)
    {
        return _ProjectionPressureRead[neighborIndex];
    }

    if (neighborType == PROJECTION_AIR)
    {
        // Free surface pressure = 0.
        if (_ProjectionAirPressureZero != 0)
            return 0.0;

        return centerPressure;
    }

    if (neighborType == PROJECTION_SOLID)
    {
        // Solid wall: zero pressure gradient.
        if (_ProjectionSolidPressureNeumann != 0)
            return centerPressure;

        return 0.0;
    }

    return centerPressure;
}

float3 ClampSpeed(float3 v)
{
    float len = length(v);

    if (len > _MaxParticleSpeed && len > 1e-6)
        v = v / len * _MaxParticleSpeed;

    return v;
}

float ClampScalar(float x, float limit)
{
    return clamp(x, -limit, limit);
}

float3 ClampVector3(float3 v, float limit)
{
    v.x = ClampScalar(v.x, limit);
    v.y = ClampScalar(v.y, limit);
    v.z = ClampScalar(v.z, limit);
    return v;
}

float3 WorldToGrid(float3 p)
{
    return (p - _GridOrigin) * _InvCellSize;
}

float3 GridToWorld(float3 g)
{
    return _GridOrigin + g * _CellSize;
}

void QuadraticBSplineWeights(float f, out float3 w, out float3 dw)
{
    // For base = floor(gridPos - 0.5)
    // fx = gridPos - base
    // offsets 0,1,2

    float f0 = 1.5 - f;
    float f1 = f - 1.0;
    float f2 = f - 0.5;

    w.x = 0.5 * f0 * f0;
    w.y = 0.75 - f1 * f1;
    w.z = 0.5 * f2 * f2;

    // Derivatives with respect to f
    dw.x = f - 1.5;
    dw.y = -2.0 * (f - 1.0);
    dw.z = f - 0.5;
}

float GetV3(float3 v, int i)
{
    if (i == 0) return v.x;
    if (i == 1) return v.y;
    return v.z;
}

float3 QuadraticWeightGradientWorld(
    float3 wx,
    float3 wy,
    float3 wz,
    float3 dwx,
    float3 dwy,
    float3 dwz,
    int ox,
    int oy,
    int oz)
{
    float wxi = GetV3(wx, ox);
    float wyi = GetV3(wy, oy);
    float wzi = GetV3(wz, oz);

    float dwxi = GetV3(dwx, ox);
    float dwyi = GetV3(dwy, oy);
    float dwzi = GetV3(dwz, oz);

    return float3(
        dwxi * wyi * wzi,
        wxi * dwyi * wzi,
        wxi * wyi * dwzi
    ) * _InvCellSize;
}

bool UseLinearTransferStencil(uint particleIndex)
{
    return
        _EnableAdaptiveTransferStencil != 0 &&
        _EnableAdaptiveMultiRate != 0 &&
        _AdaptiveParticlePriorityRead[particleIndex] == 0u;
}

float LinearWeight(float f, int offset)
{
    return offset == 0 ? 1.0 - f : f;
}

float3 ApplyAffineRows(float3 c0, float3 c1, float3 c2, float3 dpos)
{
    return float3(
        dot(c0, dpos),
        dot(c1, dpos),
        dot(c2, dpos)
    );
}

float DeterminantRows(float3 r0, float3 r1, float3 r2)
{
    return dot(r0, cross(r1, r2));
}

float3 GetColumn0(float3 r0, float3 r1, float3 r2)
{
    return float3(r0.x, r1.x, r2.x);
}

float3 GetColumn1(float3 r0, float3 r1, float3 r2)
{
    return float3(r0.y, r1.y, r2.y);
}

float3 GetColumn2(float3 r0, float3 r1, float3 r2)
{
    return float3(r0.z, r1.z, r2.z);
}

float3 RowTimesMatrix(float3 row, float3 f0, float3 f1, float3 f2)
{
    float3 c0 = GetColumn0(f0, f1, f2);
    float3 c1 = GetColumn1(f0, f1, f2);
    float3 c2 = GetColumn2(f0, f1, f2);

    return float3(
        dot(row, c0),
        dot(row, c1),
        dot(row, c2)
    );
}

float3 MatVecRows(float3 r0, float3 r1, float3 r2, float3 v)
{
    return float3(
        dot(r0, v),
        dot(r1, v),
        dot(r2, v)
    );
}

float DotRows3(float3 r0, float3 r1, float3 r2)
{
    return dot(r0, r0) + dot(r1, r1) + dot(r2, r2);
}

void BuildStrainRateRows(
    float3 c0,
    float3 c1,
    float3 c2,
    out float3 d0,
    out float3 d1,
    out float3 d2)
{
    // D = 0.5 * (C + C^T)
    float3 ct0 = float3(c0.x, c1.x, c2.x);
    float3 ct1 = float3(c0.y, c1.y, c2.y);
    float3 ct2 = float3(c0.z, c1.z, c2.z);

    d0 = 0.5 * (c0 + ct0);
    d1 = 0.5 * (c1 + ct1);
    d2 = 0.5 * (c2 + ct2);
}

float ComputeShearRateFromD(float3 d0, float3 d1, float3 d2)
{
    float dd = DotRows3(d0, d1, d2);

    // gammaDot = sqrt(2 D:D)
    return sqrt(max(2.0 * dd, 0.0));
}

float EvaluateEffectivePaintViscosity(float shearRate)
{
    float baseViscosity = max(_MpmViscosity, 0.0);

    if (_EnablePaintRheology == 0)
        return baseViscosity;

    float gamma = max(shearRate, 1e-5);

    float mu0 = max(_LowShearViscosity, 0.0);
    float muInf = max(_HighShearViscosity, 0.0);

    // Safety: high-shear viscosity should not exceed low-shear viscosity.
    muInf = min(muInf, mu0);

    float lambdaGamma = max(_ShearThinningRelaxationTime, 0.0) * gamma;

    float n = clamp(_ShearThinningPowerN, 0.05, 1.0);
    float a = clamp(_CarreauYasudaExponent, 0.25, 8.0);

    // Carreau-Yasuda shear-thinning:
    // mu = muInf + (mu0 - muInf) *
    //      (1 + (lambda*gamma)^a)^((n - 1) / a)
    float exponent = (n - 1.0) / a;

    float shearFactor = pow(
        1.0 + pow(lambdaGamma, a),
        exponent
    );

    float shearViscosity = muInf + (mu0 - muInf) * shearFactor;

    float yieldViscosity = 0.0;

    if (_YieldStress > 0.0)
    {
        float regularization = max(_YieldRegularizationRate, 0.0);
        float yieldRamp =
            regularization > 0.0
                ? 1.0 - exp(-regularization * gamma)
                : 1.0;
        yieldViscosity = _YieldStress * yieldRamp / gamma;
        yieldViscosity = min(yieldViscosity, _MaxYieldViscosityContribution);
    }

    float rheologyViscosity = shearViscosity + yieldViscosity;

    rheologyViscosity = clamp(
        rheologyViscosity,
        0.0,
        max(_MaxEffectiveViscosity, 0.001)
    );

    return lerp(
        baseViscosity,
        rheologyViscosity,
        saturate(_RheologyStrength)
    );
}

void BuildPaintViscousStressRows(
    float3 c0,
    float3 c1,
    float3 c2,
    out float3 s0,
    out float3 s1,
    out float3 s2)
{
    float3 d0, d1, d2;
    BuildStrainRateRows(c0, c1, c2, d0, d1, d2);

    float shearRate = ComputeShearRateFromD(d0, d1, d2);
    float effectiveViscosity =
        EvaluateEffectivePaintViscosity(shearRate);

    s0 = 2.0 * effectiveViscosity * d0;
    s1 = 2.0 * effectiveViscosity * d1;
    s2 = 2.0 * effectiveViscosity * d2;

    s0 = ClampVector3(s0, _MaxStressMagnitude);
    s1 = ClampVector3(s1, _MaxStressMagnitude);
    s2 = ClampVector3(s2, _MaxStressMagnitude);
}

