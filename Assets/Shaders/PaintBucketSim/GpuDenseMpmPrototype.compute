[numthreads(256, 1, 1)]
void KClearGrid(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;

    if (index >= (uint)_GridNodeCount)
        return;

    _GridAccumInt[index] = int4(0, 0, 0, 0);
    _GridVelocityMass[index] = float4(0, 0, 0, 0);
}

[numthreads(256, 1, 1)]
void KP2G(uint3 id : SV_DispatchThreadID)
{
    uint particleIndex = id.x;

    if (particleIndex >= (uint)_ParticleCount)
        return;

    float4 pr = _ParticlePositionRadius[particleIndex];
    float4 vm = _ParticleVelocityMass[particleIndex];
    float4 stateAgeId = _ParticleStateAgeIdRead[particleIndex];

    int state = (int)round(stateAgeId.x);

    if (!IsMpmActiveState(state))
        return;

    float3 p = pr.xyz;
    float3 v = vm.xyz;
    float mass = max(vm.w, 1e-12);

    float3 c0 = _ParticleAffineC0[particleIndex].xyz;
    float3 c1 = _ParticleAffineC1[particleIndex].xyz;
    float3 c2 = _ParticleAffineC2[particleIndex].xyz;

    //float4 volumeJ = _ParticleVolumeJRead[particleIndex];
    //float restVolume = max(volumeJ.x, 0.0);
    //float J = clamp(volumeJ.y, _MinJ, _MaxJ);
    float4 volumeJ = _ParticleVolumeJRead[particleIndex];
    float restVolume = max(volumeJ.x, 1e-12);
    float restDensity = max(volumeJ.z, 1.0);
    float J = clamp(volumeJ.y, _MinJ, _MaxJ);

    float3 stress0 = float3(0, 0, 0);
    float3 stress1 = float3(0, 0, 0);
    float3 stress2 = float3(0, 0, 0);

    if (_EnableMaterialStress != 0)
    {
        BuildStressRows(c0, c1, c2, J, stress0, stress1, stress2);
    }

    //float3 gridPos = WorldToGrid(p);

    //int3 baseCell = (int3)floor(gridPos);
    //float3 f = frac(gridPos);

    float3 gridPos = WorldToGrid(p);

    ////////   G6.B Changes   ////////
    // Quadratic B-Spline uses 3 nodes per axis.
    // We shift by 0.5 so the particle is centered over a 3-node stencil.
    int3 baseCell = (int3)floor(gridPos - 0.5);
    float3 f = gridPos - (float3)baseCell;

    float3 wx, wy, wz;
    float3 dwx, dwy, dwz;

    QuadraticBSplineWeights(f.x, wx, dwx);
    QuadraticBSplineWeights(f.y, wy, dwy);
    QuadraticBSplineWeights(f.z, wz, dwz);
    ////////  End G6.B Changes   ////////

    for (int dz = 0; dz <= 2; dz++)
    {
        for (int dy = 0; dy <= 2; dy++)
        {
            for (int dx = 0; dx <= 2; dx++)
            {
                int3 node = baseCell + int3(dx, dy, dz);

                if (!IsValidCell(node))
                    continue;

//                float wx = dx == 0 ? (1.0 - f.x) : f.x;
//                float wy = dy == 0 ? (1.0 - f.y) : f.y;
//                float wz = dz == 0 ? (1.0 - f.z) : f.z;

//                float w = wx * wy * wz;

                ////////  G6.B Changes   ////////
                float wxi = GetV3(wx, dx);
                float wyi = GetV3(wy, dy);
                float wzi = GetV3(wz, dz);

                float w = wxi * wyi * wzi;
                ////////  End G6.B Changes   ////////

                int nodeIndex = FlattenGridIndex(node);

                float3 nodeWorld = GridToWorld((float3)node);
                float3 dpos = nodeWorld - p;

                //float3 affineVelocity = float3(0, 0, 0);

                //if (_EnableApicTransfer != 0)
                //    affineVelocity = ApplyAffineRows(c0, c1, c2, dpos) * _ApicP2GStrength;

                //float3 nodeContributionVelocity = v + affineVelocity;
                float3 affineVelocity = ApplyAffineRows(c0, c1, c2, dpos);

                float3 nodeContributionVelocity = v + affineVelocity;

                float3 momentum = w * mass * nodeContributionVelocity;

                if (_EnableMaterialStress != 0 && restVolume > 0.0)
                {
                    //float3 gradW = WeightGradientWorld(f, dx, dy, dz);
  
                    ////////  G6.B Changes   ////////
                    float3 gradW = QuadraticWeightGradientWorld(
                        wx, wy, wz,
                        dwx, dwy, dwz,
                        dx, dy, dz
                    );
                    ////////  End G6.B Changes   ////////

                    // Momentum contribution from stress force over dt:
                    // p += -dt * V0 * stress * gradW
                    float3 stressForce = -_Dt * restVolume * MatVecRows(stress0, stress1, stress2, gradW) * _MaterialStressStrength;

                    momentum += stressForce;
                }

                int mFixed = (int)round(w * mass * _MassFixedScale);

                int pxFixed = (int)round(momentum.x * _MomentumFixedScale);
                int pyFixed = (int)round(momentum.y * _MomentumFixedScale);
                int pzFixed = (int)round(momentum.z * _MomentumFixedScale);

                InterlockedAdd(_GridAccumInt[nodeIndex].x, mFixed);
                InterlockedAdd(_GridAccumInt[nodeIndex].y, pxFixed);
                InterlockedAdd(_GridAccumInt[nodeIndex].z, pyFixed);
                InterlockedAdd(_GridAccumInt[nodeIndex].w, pzFixed);
            }
        }
    }
}

[numthreads(256, 1, 1)]
void KGridUpdate(uint3 id : SV_DispatchThreadID)
{
    uint nodeIndex = id.x;

    if (nodeIndex >= (uint)_GridNodeCount)
        return;

    int4 accum = _GridAccumInt[nodeIndex];

    float mass = (float)accum.x / max((float)_MassFixedScale, 1.0);

    if (mass <= 1e-8)
    {
        _GridVelocityMass[nodeIndex] = float4(0, 0, 0, 0);
        return;
    }

    float3 momentum = float3(
        (float)accum.y / max((float)_MomentumFixedScale, 1.0),
        (float)accum.z / max((float)_MomentumFixedScale, 1.0),
        (float)accum.w / max((float)_MomentumFixedScale, 1.0)
    );

    float3 v = momentum / mass;

    v += _Gravity * _Dt;

    if (_VelocityDampingPerSecond > 0.0)
    {
        float damping = exp(-_VelocityDampingPerSecond * _Dt);
        v *= damping;
    }

    uint gx = (uint)_GridResolution.x;
    uint gy = (uint)_GridResolution.y;
    uint xy = gx * gy;

    uint z = nodeIndex / xy;
    uint rem = nodeIndex - z * xy;
    uint y = rem / gx;
    uint x = rem - y * gx;

    //if (_EnableBoxBoundary != 0)
    //{
    //    if (x <= 1u && v.x < 0) v.x = -v.x * _BoundaryDamping;
    //    if (x >= gx - 2u && v.x > 0) v.x = -v.x * _BoundaryDamping;

    //    if (y <= 1u && v.y < 0) v.y = -v.y * _BoundaryDamping;
    //    if (y >= gy - 2u && v.y > 0) v.y = -v.y * _BoundaryDamping;

    //    uint gz = (uint)_GridResolution.z;

    //    if (z <= 1u && v.z < 0) v.z = -v.z * _BoundaryDamping;
    //    if (z >= gz - 2u && v.z > 0) v.z = -v.z * _BoundaryDamping;
    //}

    v = ClampSpeed(v);

    _GridVelocityMass[nodeIndex] = float4(v, mass);
}

[numthreads(256, 1, 1)]
void KG2PVelocityApic(uint3 id : SV_DispatchThreadID)
{
    uint particleIndex = id.x;

    if (particleIndex >= (uint)_ParticleCount)
        return;

    float4 pr = _ParticlePositionRadius[particleIndex];
    float4 vm = _ParticleVelocityMass[particleIndex];
    float4 stateAgeId = _ParticleStateAgeIdRead[particleIndex];

    int state = (int)round(stateAgeId.x);

    if (!IsMpmActiveState(state))
        return;

    float3 p = pr.xyz;
    float radius = pr.w;

    float3 oldV = vm.xyz;
    float mass = vm.w;

    //float3 gridPos = WorldToGrid(p);
    //int3 baseCell = (int3)floor(gridPos);
    //float3 f = frac(gridPos);

    //      G6.B        //
    float3 gridPos = WorldToGrid(p);

    int3 baseCell = (int3)floor(gridPos - 0.5);
    float3 f = gridPos - (float3)baseCell;

    float3 wx, wy, wz;
    float3 dwx, dwy, dwz;

    QuadraticBSplineWeights(f.x, wx, dwx);
    QuadraticBSplineWeights(f.y, wy, dwy);
    QuadraticBSplineWeights(f.z, wz, dwz);
    //      End G6.B        //

    float3 gridVelocity = float3(0, 0, 0);
    float weightSum = 0.0;

    float3 b0 = float3(0, 0, 0);
    float3 b1 = float3(0, 0, 0);
    float3 b2 = float3(0, 0, 0);

    for (int dz = 0; dz <= 2; dz++)
    {
        for (int dy = 0; dy <= 2; dy++)
        {
            for (int dx = 0; dx <= 2; dx++)
            {
                int3 node = baseCell + int3(dx, dy, dz);

                if (!IsValidCell(node))
                    continue;

                //float wx = dx == 0 ? (1.0 - f.x) : f.x;
                //float wy = dy == 0 ? (1.0 - f.y) : f.y;
                //float wz = dz == 0 ? (1.0 - f.z) : f.z;

                //float w = wx * wy * wz;
                
                //      G6.B        //
                float wxi = GetV3(wx, dx);
                float wyi = GetV3(wy, dy);
                float wzi = GetV3(wz, dz);

                float w = wxi * wyi * wzi;
                //      End G6.B        //

                int nodeIndex = FlattenGridIndex(node);

                float4 gv = _GridVelocityMassRead[nodeIndex];

                if (gv.w <= 1e-8)
                    continue;

                float3 nodeVelocity = gv.xyz;

                gridVelocity += w * nodeVelocity;
                weightSum += w;

                //if (_EnableApicTransfer != 0)
                //{
                float3 nodeWorld = GridToWorld((float3)node);
                float3 dpos = nodeWorld - p;

                b0 += w * nodeVelocity.x * dpos;
                b1 += w * nodeVelocity.y * dpos;
                b2 += w * nodeVelocity.z * dpos;
                //}
            }
        }
    }

    float3 newV = oldV;

    if (weightSum > 1e-6)
    {
        gridVelocity /= weightSum;
        newV = gridVelocity;
    }

    newV = ClampSpeed(newV);

    float3 c0Old = _ParticleAffineC0[particleIndex].xyz;
    float3 c1Old = _ParticleAffineC1[particleIndex].xyz;
    float3 c2Old = _ParticleAffineC2[particleIndex].xyz;

    float3 c0New = c0Old;
    float3 c1New = c1Old;
    float3 c2New = c2Old;

    if (weightSum > 1e-6)
    {
        c0New = b0 * _ApicDInverse;
        c1New = b1 * _ApicDInverse;
        c2New = b2 * _ApicDInverse;

        //c0New = lerp(c0Old, c0New, _ApicG2PStrength);
        //c1New = lerp(c1Old, c1New, _ApicG2PStrength);
        //c2New = lerp(c2Old, c2New, _ApicG2PStrength);

        float affineKeep = saturate(1.0 - _AffineDamping);

        c0New *= affineKeep;
        c1New *= affineKeep;
        c2New *= affineKeep;

        c0New = ClampVector3(c0New, _MaxAffineMagnitude);
        c1New = ClampVector3(c1New, _MaxAffineMagnitude);
        c2New = ClampVector3(c2New, _MaxAffineMagnitude);

        _ParticleAffineC0[particleIndex] = float4(c0New, 0);
        _ParticleAffineC1[particleIndex] = float4(c1New, 0);
        _ParticleAffineC2[particleIndex] = float4(c2New, 0);

    }

    // Update deformation gradient: F_new = (I + dt * C) F_old
    //float3 f0Old = _ParticleF0[particleIndex].xyz;
    //float3 f1Old = _ParticleF1[particleIndex].xyz;
    //float3 f2Old = _ParticleF2[particleIndex].xyz;

    //float3 a0 = float3(1, 0, 0) + _Dt * c0New;
    //float3 a1 = float3(0, 1, 0) + _Dt * c1New;
    //float3 a2 = float3(0, 0, 1) + _Dt * c2New;

    //float3 f0New = RowTimesMatrix(a0, f0Old, f1Old, f2Old);
    //float3 f1New = RowTimesMatrix(a1, f0Old, f1Old, f2Old);
    //float3 f2New = RowTimesMatrix(a2, f0Old, f1Old, f2Old);

    //f0New = ClampVector3(f0New, _MaxDeformationGradientValue);
    //f1New = ClampVector3(f1New, _MaxDeformationGradientValue);
    //f2New = ClampVector3(f2New, _MaxDeformationGradientValue);

    //float J = DeterminantRows(f0New, f1New, f2New);
    //J = clamp(J, _MinJ, _MaxJ);

    //float4 volumeJ = _ParticleVolumeJ[particleIndex];
    //volumeJ.y = J;

    p += newV * _Dt;

    //if (_EnableBoxBoundary != 0)
    //{
    //    float3 minP = _GridOrigin + float3(radius, radius, radius);
    //    float3 maxP = _GridOrigin +
    //                  float3(_GridResolution) * _CellSize -
    //                  float3(radius, radius, radius);

    //    if (p.x < minP.x) { p.x = minP.x; newV.x = abs(newV.x) * _BoundaryDamping; }
    //    if (p.x > maxP.x) { p.x = maxP.x; newV.x = -abs(newV.x) * _BoundaryDamping; }

    //    if (p.y < minP.y) { p.y = minP.y; newV.y = abs(newV.y) * _BoundaryDamping; }
    //    if (p.y > maxP.y) { p.y = maxP.y; newV.y = -abs(newV.y) * _BoundaryDamping; }

    //    if (p.z < minP.z) { p.z = minP.z; newV.z = abs(newV.z) * _BoundaryDamping; }
    //    if (p.z > maxP.z) { p.z = maxP.z; newV.z = -abs(newV.z) * _BoundaryDamping; }
    //}

    _ParticlePositionRadius[particleIndex] = float4(p, radius);
    _ParticleVelocityMass[particleIndex] = float4(newV, mass);

    //_ParticleF0[particleIndex] = float4(f0New, 0);
    //_ParticleF1[particleIndex] = float4(f1New, 0);
    //_ParticleF2[particleIndex] = float4(f2New, 0);

    //_ParticleVolumeJ[particleIndex] = volumeJ;
}


/// /// /// /// /// /// /// /// G8.A Changes  /// /// /// /// /// /// /// /// /// ///

float3 TransformPoint(float4x4 m, float3 p)
{
    return mul(m, float4(p, 1.0)).xyz;
}

float3 TransformVector(float4x4 m, float3 v)
{
    return mul(m, float4(v, 0.0)).xyz;
}

float BucketOuterRadiusAtY(float y)
{
    float halfH = 0.5 * _BucketHeight;

    float t = saturate((y + halfH) / max(_BucketHeight, 1e-6));

    // shapeType:
    // 0 = Cylinder
    // 1 = TaperedCylinder
    if (_BucketShapeType == 0)
        return _BucketTopRadius;

    return lerp(_BucketBottomRadius, _BucketTopRadius, t);
}

float BucketInnerRadiusAtY(float y)
{
    return max(
        BucketOuterRadiusAtY(y) - _BucketWallThickness,
        0.001
    );
}

float2 SafeNormalize2(float2 v)
{
    float len = length(v);
    if (len < 1e-6)
        return float2(1, 0);

    return v / len;
}

float3 RemoveNormalComponent(float3 v, float3 n)
{
    return v - dot(v, n) * n;
}

float3 ApplyCollisionVelocity(float3 vLocal, float3 normalLocal)
{
    normalLocal = normalize(normalLocal);

    float vn = dot(vLocal, normalLocal);
    float3 vt = vLocal - vn * normalLocal;

    // If velocity goes into the wall, reflect/dampen normal part.
    if (vn < 0.0)
    {
        vn = -vn * _BucketRestitution;
    }

    vt *= saturate(1.0 - _BucketFriction);

    return vt + vn * normalLocal;
}

bool IsInsideBottomHoleRegion(float3 localP, float radius)
{
    float2 p = localP.xz;
    float2 c = _HoleLocalCenter.xz;

    float r =
        _HoleRadius +
        _HoleRadialPadding +
        radius;

    float radialOk = length(p - c) <= r;

    float bottomY = -0.5 * _BucketHeight;

    float heightOk = abs(localP.y - bottomY) <= max(_HoleNearHeight, radius * 2.0);

    return radialOk && heightOk;
}

bool IsInsideBucketInteriorLocal(float3 pLocal)             
{
    float halfH = 0.5 * _BucketHeight;

    float bottomY = -halfH;
    float topY = halfH;

    if (pLocal.y < bottomY)
        return false;

    if (_ProjectionTopOpen != 0)
    {
        if (pLocal.y > topY)
            return false;
    }
    else
    {
        if (pLocal.y > topY)
            return false;
    }

    float innerRadius =
        BucketInnerRadiusAtY(clamp(pLocal.y, bottomY, topY));

    float radial = length(pLocal.xz);

    return radial <= innerRadius;
}

/// /// /// /// /// /// /// ///     G8.B Changes  /// /// /// /// /// /// /// /// /// ///


float3 ComputeBucketWallVelocityWorld(float3 pWorld)
{
    if (_EnableMovingBucketBoundaryVelocity == 0)
        return float3(0, 0, 0);

    // Bucket center/origin in world.
    float3 bucketCenterWorld = TransformPoint(_BucketLocalToWorld, float3(0, 0, 0));

    float3 r = pWorld - bucketCenterWorld;

    float3 wallVelocity =
        _BucketLinearVelocityWorld +
        cross(_BucketAngularVelocityWorld, r);

    wallVelocity *= saturate(_BucketBoundaryVelocityStrength);

    wallVelocity = ClampVectorLength(
        wallVelocity,
        _MaxBucketBoundaryVelocity
    );

    return wallVelocity;
}

float3 ComputeProjectionWallVelocityWorld(float3 pWorld)
{
    if (_EnableMovingBucketProjectionCoupling == 0)
        return float3(0, 0, 0);

    float3 wallVelocity = ComputeBucketWallVelocityWorld(pWorld);

    wallVelocity *= saturate(
        _ProjectionMovingBoundaryVelocityStrength
    );

    return ClampVectorLength(
        wallVelocity,
        _MaxBucketBoundaryVelocity
    );
}

float3 ApplyMovingWallNoPenetrationWorld(
    float3 velocityWorld,
    float3 wallVelocityWorld,
    float3 normalTowardFluidWorld)
{
    normalTowardFluidWorld = normalize(normalTowardFluidWorld);

    float3 relativeVelocity =
        velocityWorld - wallVelocityWorld;

    float vn = dot(relativeVelocity, normalTowardFluidWorld);

    // إذا vn < 0 فهذا يعني أن السرعة النسبية تضغط باتجاه الجدار.
    if (vn < 0.0)
    {
        float3 correction =
            -vn * normalTowardFluidWorld;

        correction = ClampVectorLength(
            correction,
            _MaxProjectionBoundaryVelocityCorrection
        );

        velocityWorld += correction;
    }

    return velocityWorld;
}

float3 ComputeBucketWallVelocityLocal(float3 pLocal)
{
    float3 pWorld = TransformPoint(_BucketLocalToWorld, pLocal);
    float3 wallVelocityWorld = ComputeBucketWallVelocityWorld(pWorld);

    return TransformVector(_BucketWorldToLocal, wallVelocityWorld);
}

float3 ApplyCollisionVelocityAgainstMovingWall(
    float3 particleVelocityLocal,
    float3 normalLocal,
    float3 wallVelocityLocal)
{
    float3 relativeVelocity =
        particleVelocityLocal -
        wallVelocityLocal;

    relativeVelocity =
        ApplyCollisionVelocity(relativeVelocity, normalLocal);

    return relativeVelocity + wallVelocityLocal;
}
/// /// /// /// /// /// /// ///   End G8.B Changes  /// /// /// /// /// /// /// /// /// ///


[numthreads(256, 1, 1)]
void KClearProjectionGrid(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;

    if (index >= (uint)_GridNodeCount)
        return;

    _ProjectionCellType[index] = PROJECTION_AIR;
    _ProjectionCellMassInt[index] = 0;

    _ProjectionCellData[index] = float4(0, 0, 0, 0);

    _ProjectionPressure[index] = 0.0;
    _ProjectionPressureTemp[index] = 0.0;
    _ProjectionDivergence[index] = 0.0;
}

[numthreads(256, 1, 1)]
void KMarkBucketProjectionSolids(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;

    if (index >= (uint)_GridNodeCount)
        return;

    if (_EnableProjectionGrid == 0 ||
        _EnableBucketProjectionSolidCells == 0 ||
        _UseRealBucketCollision == 0)
    {
        return;
    }

    int3 cell = UnflattenGridIndex((int)index);

    // Cell center in world space.
    float3 worldP = GridToWorld((float3)cell + float3(0.5, 0.5, 0.5));

    float3 localP = TransformPoint(_BucketWorldToLocal, worldP);

    bool insideInterior = IsInsideBucketInteriorLocal(localP);

    if (!insideInterior)
    {
        _ProjectionCellType[index] = PROJECTION_SOLID;
    }
}

[numthreads(256, 1, 1)]
void KMarkProjectionFluidCells(uint3 id : SV_DispatchThreadID)
{
    uint particleIndex = id.x;

    if (particleIndex >= (uint)_ParticleCount)
        return;

    if (_EnableProjectionGrid == 0)
        return;

    float4 stateAgeId = _ParticleStateAgeIdRead[particleIndex];
    int state = (int)round(stateAgeId.x);

    if (!IsMpmActiveState(state))
        return;

    float3 p = _ParticlePositionRadiusRead[particleIndex].xyz;
    float mass = max(_ParticleVelocityMassRead[particleIndex].w, 0.0);

    if (mass <= 0.0)
        return;

    float3 gridPos = WorldToGrid(p);

    int3 baseCell = (int3)floor(gridPos - 0.5);
    float3 f = gridPos - (float3)baseCell;

    float3 wx, wy, wz;
    float3 dwx, dwy, dwz;

    QuadraticBSplineWeights(f.x, wx, dwx);
    QuadraticBSplineWeights(f.y, wy, dwy);
    QuadraticBSplineWeights(f.z, wz, dwz);

    for (int dz = 0; dz <= 2; dz++)
    {
        for (int dy = 0; dy <= 2; dy++)
        {
            for (int dx = 0; dx <= 2; dx++)
            {
                int3 node = baseCell + int3(dx, dy, dz);

                if (!IsValidCell(node))
                    continue;

                int index = FlattenGridIndex(node);

                if (_ProjectionCellType[index] == PROJECTION_SOLID)
                    continue;

                float wxi = GetV3(wx, dx);
                float wyi = GetV3(wy, dy);
                float wzi = GetV3(wz, dz);

                float w = wxi * wyi * wzi;

                if (w <= 1e-6)
                    continue;

                int massFixed =
                    (int)round(w * mass * (float)_ProjectionMassFixedScale);

                InterlockedAdd(_ProjectionCellMassInt[index], massFixed);

                _ProjectionCellType[index] = PROJECTION_FLUID;
            }
        }
    }
}

[numthreads(256, 1, 1)]
void KFinalizeProjectionGrid(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;

    if (index >= (uint)_GridNodeCount)
        return;

    if (_EnableProjectionGrid == 0)
        return;

    int cellType = _ProjectionCellType[index];

    if (cellType == PROJECTION_SOLID)
    {
        _ProjectionCellData[index] = float4(0, 0, 1, 0);
        return;
    }

    float mass =
        (float)_ProjectionCellMassInt[index] /
        max((float)_ProjectionMassFixedScale, 1.0);

    if (mass >= _ProjectionMinFluidCellMass)
    {
        _ProjectionCellType[index] = PROJECTION_FLUID;

        // x = mass, y = reserved density ratio, z = fluid flag, w = reserved
        _ProjectionCellData[index] = float4(mass, 0, 1, 0);
    }
    else
    {
        _ProjectionCellType[index] = PROJECTION_AIR;
        _ProjectionCellData[index] = float4(0, 0, 0, 0);
    }
}

[numthreads(256, 1, 1)]
void KApplyMovingBucketProjectionBoundaryVelocity(
    uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;

    if (index >= (uint)_GridNodeCount)
        return;

    if (_EnableProjectionGrid == 0 ||
        _EnableMovingBucketProjectionCoupling == 0 ||
        _ApplyMovingBucketGridBoundaryVelocity == 0)
    {
        return;
    }

    int cellType = _ProjectionCellTypeRead[index];

    if (cellType != PROJECTION_FLUID)
        return;

    float4 velocityMass = _GridVelocityMass[index];

    if (velocityMass.w <= 1e-8)
        return;

    int3 cell = UnflattenGridIndex((int)index);

    float3 centerWorld =
        GridToWorld((float3)cell + float3(0.5, 0.5, 0.5));

    float3 v = velocityMass.xyz;

    // Directions from fluid cell toward neighbor.
    int3 dirs[6] =
    {
        int3(-1, 0, 0),
        int3( 1, 0, 0),
        int3(0, -1, 0),
        int3(0,  1, 0),
        int3(0, 0, -1),
        int3(0, 0,  1)
    };

    float3 dirsWorld[6] =
    {
        float3(-1, 0, 0),
        float3( 1, 0, 0),
        float3(0, -1, 0),
        float3(0,  1, 0),
        float3(0, 0, -1),
        float3(0, 0,  1)
    };

    for (int i = 0; i < 6; i++)
    {
        int3 neighbor = cell + dirs[i];

        bool solidNeighbor = false;

        if (!IsValidCell(neighbor))
        {
            solidNeighbor = true;
        }
        else
        {
            int nIndex = FlattenGridIndex(neighbor);
            solidNeighbor =
                _ProjectionCellTypeRead[nIndex] == PROJECTION_SOLID;
        }

        if (!solidNeighbor)
            continue;

        // Direction from current fluid cell toward solid neighbor.
        float3 dirToSolid = dirsWorld[i];

        // Normal from wall toward fluid is opposite.
        float3 normalTowardFluid = -dirToSolid;

        float3 faceWorld =
            centerWorld + dirToSolid * (0.5 * _CellSize);

        float3 wallVelocity =
            ComputeProjectionWallVelocityWorld(faceWorld);

        v = ApplyMovingWallNoPenetrationWorld(
            v,
            wallVelocity,
            normalTowardFluid
        );
    }

    v = ClampSpeed(v);

    _GridVelocityMass[index] = float4(v, velocityMass.w);
}

float3 GetProjectionFaceVelocity(
    int3 centerCell,
    int3 neighborCell,
    float3 dirToNeighbor,
    float3 centerVelocity)
{
    float3 centerWorld =
        GridToWorld((float3)centerCell + float3(0.5, 0.5, 0.5));

    float3 faceWorld =
        centerWorld + dirToNeighbor * (0.5 * _CellSize);

    if (!IsValidCell(neighborCell))
    {
        if (_UseMovingBucketVelocityInDivergence != 0)
            return ComputeProjectionWallVelocityWorld(faceWorld);

        return centerVelocity;
    }

    int neighborIndex = FlattenGridIndex(neighborCell);
    int neighborType = _ProjectionCellTypeRead[neighborIndex];

    if (neighborType == PROJECTION_SOLID)
    {
        if (_UseMovingBucketVelocityInDivergence != 0)
            return ComputeProjectionWallVelocityWorld(faceWorld);

        return centerVelocity;
    }

    float3 neighborVelocity =
        _GridVelocityMassRead[neighborIndex].xyz;

    if (neighborType == PROJECTION_FLUID)
    {
        return 0.5 * (centerVelocity + neighborVelocity);
    }

    // Air boundary V1:
    // For now, average with air velocity. Later free-surface handling will improve this.
    return 0.5 * (centerVelocity + neighborVelocity);
}

[numthreads(256, 1, 1)]
void KComputeProjectionDivergence(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;

    if (index >= (uint)_GridNodeCount)
        return;

    if (_EnableProjectionGrid == 0 ||
        _EnableProjectionDivergence == 0)
    {
        return;
    }

    int cellType = _ProjectionCellTypeRead[index];

    if (cellType != PROJECTION_FLUID)
    {
        _ProjectionDivergence[index] = 0.0;
        return;
    }

    int3 cell = UnflattenGridIndex((int)index);

    float3 centerVelocity =
        _GridVelocityMassRead[index].xyz;

    float3 vL = GetProjectionFaceVelocity(
        cell,
        cell + int3(-1, 0, 0),
        float3(-1, 0, 0),
        centerVelocity
    );

    float3 vR = GetProjectionFaceVelocity(
        cell,
        cell + int3(1, 0, 0),
        float3(1, 0, 0),
        centerVelocity
    );

    float3 vD = GetProjectionFaceVelocity(
        cell,
        cell + int3(0, -1, 0),
        float3(0, -1, 0),
        centerVelocity
    );

    float3 vU = GetProjectionFaceVelocity(
        cell,
        cell + int3(0, 1, 0),
        float3(0, 1, 0),
        centerVelocity
    );

    float3 vB = GetProjectionFaceVelocity(
        cell,
        cell + int3(0, 0, -1),
        float3(0, 0, -1),
        centerVelocity
    );

    float3 vF = GetProjectionFaceVelocity(
        cell,
        cell + int3(0, 0, 1),
        float3(0, 0, 1),
        centerVelocity
    );

    float divergence =
        _InvCellSize *
        (
            (vR.x - vL.x) +
            (vU.y - vD.y) +
            (vF.z - vB.z)
        );

    divergence *= _ProjectionDivergenceScale;
    divergence = ClampDivergence(divergence);

    _ProjectionDivergence[index] = divergence;
}

[numthreads(256, 1, 1)]
void KJacobiProjectionPressure(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;

    if (index >= (uint)_GridNodeCount)
        return;

    if (_EnableProjectionGrid == 0 ||
        _EnableProjectionDivergence == 0 ||
        _EnableJacobiPressureSolve == 0)
    {
        return;
    }

    int cellType = _ProjectionCellTypeRead[index];

    if (cellType != PROJECTION_FLUID)
    {
        _ProjectionPressureWrite[index] = 0.0;
        return;
    }

    int3 cell = UnflattenGridIndex((int)index);

    float centerPressure = _ProjectionPressureRead[index];

    float pressureSum = 0.0;
    float diagonalCount = 0.0;

    AccumulateJacobiNeighborPressure(
        cell + int3(-1, 0, 0),
        centerPressure,
        pressureSum,
        diagonalCount
    );

    AccumulateJacobiNeighborPressure(
        cell + int3(1, 0, 0),
        centerPressure,
        pressureSum,
        diagonalCount
    );

    AccumulateJacobiNeighborPressure(
        cell + int3(0, -1, 0),
        centerPressure,
        pressureSum,
        diagonalCount
    );

    AccumulateJacobiNeighborPressure(
        cell + int3(0, 1, 0),
        centerPressure,
        pressureSum,
        diagonalCount
    );

    AccumulateJacobiNeighborPressure(
        cell + int3(0, 0, -1),
        centerPressure,
        pressureSum,
        diagonalCount
    );

    AccumulateJacobiNeighborPressure(
        cell + int3(0, 0, 1),
        centerPressure,
        pressureSum,
        diagonalCount
    );

    if (diagonalCount <= 1e-6)
    {
        _ProjectionPressureWrite[index] = 0.0;
        return;
    }

    float divergence = _ProjectionDivergenceRead[index];

    // V1 collocated Poisson prototype:
    // Laplacian(p) = divergence * scale
    //
    // p_new = (sumNeighbors - rhs * h^2) / diagonal
    //
    // Note:
    // The exact physical scaling will be tightened in G8-C5
    // when we subtract the pressure gradient from velocity.
    float h2 = _CellSize * _CellSize;

    float rhs =
        divergence *
        _ProjectionPressureRhsScale;

    float jacobiPressure =
        (pressureSum - rhs * h2) /
        max(diagonalCount, 1.0);

    float relaxedPressure = lerp(
        centerPressure,
        jacobiPressure,
        saturate(_ProjectionPressureRelaxation)
    );

    relaxedPressure = ClampProjectionPressure(relaxedPressure);

    _ProjectionPressureWrite[index] = relaxedPressure;
}

[numthreads(256, 1, 1)]
void KSubtractProjectionPressureGradient(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;

    if (index >= (uint)_GridNodeCount)
        return;

    if (_EnableProjectionGrid == 0 ||
        _EnableProjectionDivergence == 0 ||
        _EnableJacobiPressureSolve == 0 ||
        _EnablePressureGradientSubtraction == 0)
    {
        return;
    }

    int cellType = _ProjectionCellTypeRead[index];

    if (_PressureCorrectionFluidCellsOnly != 0 &&
        cellType != PROJECTION_FLUID)
    {
        return;
    }

    float4 velocityMass = _GridVelocityMass[index];

    if (velocityMass.w <= 1e-8)
        return;

    int3 cell = UnflattenGridIndex((int)index);

    float centerPressure = _ProjectionPressureRead[index];

    float pL = GetPressureForGradient(
        cell + int3(-1, 0, 0),
        centerPressure
    );

    float pR = GetPressureForGradient(
        cell + int3(1, 0, 0),
        centerPressure
    );

    float pD = GetPressureForGradient(
        cell + int3(0, -1, 0),
        centerPressure
    );

    float pU = GetPressureForGradient(
        cell + int3(0, 1, 0),
        centerPressure
    );

    float pB = GetPressureForGradient(
        cell + int3(0, 0, -1),
        centerPressure
    );

    float pF = GetPressureForGradient(
        cell + int3(0, 0, 1),
        centerPressure
    );

    float3 pressureGradient =
        0.5 * _InvCellSize *
        float3(
            pR - pL,
            pU - pD,
            pF - pB
        );

    float sign = _InvertPressureGradientSign != 0 ? -1.0 : 1.0;

    float3 velocityCorrection =
        sign *
        _ProjectionPressureGradientScale *
        pressureGradient;

    velocityCorrection = ClampVectorLength(
        velocityCorrection,
        _MaxPressureVelocityCorrection
    );

    float3 correctedVelocity =
        velocityMass.xyz - velocityCorrection;

    correctedVelocity = ClampSpeed(correctedVelocity);

    _GridVelocityMass[index] =
        float4(correctedVelocity, velocityMass.w);
}


[numthreads(256, 1, 1)]
void KBucketCollision(uint3 id : SV_DispatchThreadID)
{
    uint particleIndex = id.x;

    if (particleIndex >= (uint)_ParticleCount)
        return;

    if (_EnableGpuBucketCollision == 0 || _UseRealBucketCollision == 0)
        return;

    float4 pr = _ParticlePositionRadius[particleIndex];
    float4 vm = _ParticleVelocityMass[particleIndex];
    float4 stateAgeId = _ParticleStateAgeId[particleIndex];

    int state = (int)round(stateAgeId.x);

    // Only collide fluid-domain particles for now.
    if (!IsMpmActiveState(state))
        return;

    float3 pWorld = pr.xyz;
    float radius = pr.w;
    float3 vWorld = vm.xyz;

    float3 pLocal = TransformPoint(_BucketWorldToLocal, pWorld);
    float3 vLocal = TransformVector(_BucketWorldToLocal, vWorld);

    float halfH = 0.5 * _BucketHeight;
    float bottomY = -halfH;
    float topY = halfH;

    bool collided = false;

    // 1) Bottom hole region classification
    bool nearBottomHole = false;

    if (_ClassifyBottomHoleRegion != 0)
    {
        nearBottomHole = IsInsideBottomHoleRegion(pLocal, radius);

        if (nearBottomHole)
        {
            // FluidParticleState.NearHole = 3
            stateAgeId.x = 3.0;
        }
    }

    // 2) Side wall collision
    float innerRadius =
        BucketInnerRadiusAtY(pLocal.y) -
        _BucketCollisionPadding -
        radius;

    innerRadius = max(innerRadius, radius);

    float2 radial = pLocal.xz;
    float radialLen = length(radial);

    if (radialLen > innerRadius)
    {
        float2 n2 = SafeNormalize2(radial);

        pLocal.xz = n2 * innerRadius;

        // Normal points from wall toward inside.
        float3 normalLocal = float3(-n2.x, 0.0, -n2.y);

        float3 wallVelocityLocal =
            ComputeBucketWallVelocityLocal(pLocal);

        vLocal = ApplyCollisionVelocityAgainstMovingWall(
            vLocal,
            normalLocal,
            wallVelocityLocal
        );

        collided = true;

        // FluidParticleState.NearBoundary = 2, but do not overwrite NearHole.
        if (!nearBottomHole)
            stateAgeId.x = 2.0;
    }

    // 3) Bottom collision
    float minY = bottomY + _BucketCollisionPadding + radius;

    bool canPassThroughHole =
        _EnableBottomHoleOpening != 0 &&
        nearBottomHole;

    if (!canPassThroughHole && pLocal.y < minY)
    {
        pLocal.y = minY;

        float3 normalLocal = float3(0, 1, 0);

        float3 wallVelocityLocal =
            ComputeBucketWallVelocityLocal(pLocal);

        vLocal = ApplyCollisionVelocityAgainstMovingWall(
            vLocal,
            normalLocal,
            wallVelocityLocal
        );

        collided = true;

        if (!nearBottomHole)
            stateAgeId.x = 2.0;
    }

    // 4) Top handling
    float maxY = topY - _BucketTopPadding - radius;

    if (_BucketTopMode == 1)
    {
        // Temporary lid for stability/testing.
        if (pLocal.y > maxY)
        {
            pLocal.y = maxY;

            float3 normalLocal = float3(0, -1, 0);

            float3 wallVelocityLocal = ComputeBucketWallVelocityLocal(pLocal);

            vLocal = ApplyCollisionVelocityAgainstMovingWall(vLocal, normalLocal, wallVelocityLocal);

            collided = true;

            if (!nearBottomHole)
                stateAgeId.x = 2.0;
        }
    }
    else if (_BucketTopMode == 2)
    {
        // Mark as spilled if it exits above the top.
        if (pLocal.y > topY + radius)
        {
            // FluidParticleState.Spilled = 7
            stateAgeId.x = 7.0;
        }
    }

    // 5) If no special state, keep inside
    if (!collided && !nearBottomHole && state == 2)
    {
        // Return NearBoundary to InsideFluid when no longer colliding.
        stateAgeId.x = 1.0;
    }

    float3 correctedWorld = TransformPoint(_BucketLocalToWorld, pLocal);
    float3 correctedVelocityWorld = TransformVector(_BucketLocalToWorld, vLocal);

    _ParticlePositionRadius[particleIndex] = float4(correctedWorld, radius);
    _ParticleVelocityMass[particleIndex] = float4(correctedVelocityWorld, vm.w);
    _ParticleStateAgeId[particleIndex] = stateAgeId;
}

/// /// /// /// /// /// /// /// End G8.A Changes  /// /// /// /// /// /// /// /// /// ///

[numthreads(256, 1, 1)]
void KUpdateDeformation(uint3 id : SV_DispatchThreadID)
{
    uint particleIndex = id.x;

    if (particleIndex >= (uint)_ParticleCount)
        return;

    float4 stateAgeId = _ParticleStateAgeIdRead[particleIndex];
    int state = (int)round(stateAgeId.x);

    if (!IsMpmActiveState(state))
        return;

    float3 c0New = _ParticleAffineC0Read[particleIndex].xyz;
    float3 c1New = _ParticleAffineC1Read[particleIndex].xyz;
    float3 c2New = _ParticleAffineC2Read[particleIndex].xyz;

    float3 f0Old = _ParticleF0[particleIndex].xyz;
    float3 f1Old = _ParticleF1[particleIndex].xyz;
    float3 f2Old = _ParticleF2[particleIndex].xyz;

    float3 a0 = float3(1, 0, 0) + _Dt * c0New;
    float3 a1 = float3(0, 1, 0) + _Dt * c1New;
    float3 a2 = float3(0, 0, 1) + _Dt * c2New;

    float3 f0New = RowTimesMatrix(a0, f0Old, f1Old, f2Old);
    float3 f1New = RowTimesMatrix(a1, f0Old, f1Old, f2Old);
    float3 f2New = RowTimesMatrix(a2, f0Old, f1Old, f2Old);

    f0New = ClampVector3(f0New, _MaxDeformationGradientValue);
    f1New = ClampVector3(f1New, _MaxDeformationGradientValue);
    f2New = ClampVector3(f2New, _MaxDeformationGradientValue);

    float J = DeterminantRows(f0New, f1New, f2New);
    J = clamp(J, _MinJ, _MaxJ);

    float4 volumeJ = _ParticleVolumeJ[particleIndex];
    volumeJ.y = J;

    _ParticleF0[particleIndex] = float4(f0New, 0);
    _ParticleF1[particleIndex] = float4(f1New, 0);
    _ParticleF2[particleIndex] = float4(f2New, 0);
    _ParticleVolumeJ[particleIndex] = volumeJ;
}