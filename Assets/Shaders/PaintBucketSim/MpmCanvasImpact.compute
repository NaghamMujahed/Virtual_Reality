#pragma kernel KClearDebugCounters
#pragma kernel KCapturePreviousPositions
#pragma kernel KDepositImpacts
#pragma kernel KEmitEdgeDroplets
#pragma kernel KEvolveHybridParticles

struct MpmPaintFilmCell
{
    uint thickness;
    uint wetness;
    uint colorR;
    uint colorG;
    uint colorB;
    uint deposited;
    uint absorbed;
    uint impactCount;
    int flowU;
    int flowV;
    uint flags;
    uint reserved;
};

struct MpmCanvasHybridParticle
{
    float4 data0; // x=u01, y=v01, z=normal offset meters, w=radius cells
    float4 data1; // x=vel U cells/s, y=vel V cells/s, z=normal vel m/s, w=thickness units
    float4 data2; // rgb=color, a=wetness
    float4 data3; // x=age, y=lifetime, z=kind, w=active
};

StructuredBuffer<float4> _ParticlePositionRadiusRead;
